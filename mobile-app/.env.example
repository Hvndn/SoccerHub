# ==== Turfzone Mobile — biến môi trường ====
# Copy thành .env (Expo đọc file này khi start/build).
# EXPO_PUBLIC_* được nhúng thẳng vào bundle khi build.

# URL backend Spring Boot.
# - Local (simulator iOS / Expo Go trên cùng máy): http://localhost:8080/api/v1
# - Máy khác trong cùng Wi-Fi (thay IP của máy chạy backend):
#     EXPO_PUBLIC_API_URL=http://192.168.1.10:8080/api/v1
# - Bản build thật (Render/Vercel):
#     EXPO_PUBLIC_API_URL=https://<your-backend>.up.railway.app/api/v1
#
# Nếu để trống, app tự suy ra IP từ Expo (expo-constants) và lùi về localhost.
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
