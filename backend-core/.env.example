# ============================================================
# SoccerHub Backend - biến môi trường
# Copy sang Railway / Render -> Variables (KHÔNG commit file .env thật)
# ============================================================

# --- Cách 1 (khuyến nghị khi dùng MySQL có sẵn ở nơi khác) ---
# Dán thẳng JDBC URL đầy đủ (đè lên mọi biến MYSQL* bên dưới)
SPRING_DATASOURCE_URL=jdbc:mysql://HOST:3306/soccerhub_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&connectTimeout=15000&socketTimeout=60000
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# --- Cách 2 (khuyến nghị khi dùng MySQL plugin của Railway) ---
# Nếu đã add plugin MySQL trên Railway và "Connect"/"Reference Variables",
# Railway tự Inject các biến MYSQL* này - KHÔNG cần khai báo tay:
# MYSQLHOST=...
# MYSQLPORT=3306
# MYSQLDATABASE=soccerhub_db
# MYSQLUSER=root
# MYSQLPASSWORD=...

# --- CORS: các domain được phép gọi API ---
ALLOWED_ORIGINS=https://soccer-hub-wheat.vercel.app,http://localhost:3000

# --- AI service (FastAPI) ---
AI_SERVICE_URL=https://soccerhub-ai-service.onrender.com

# --- Debug (để false trên production) ---
JPA_SHOW_SQL=false
