# ==== Turfzone Backend — bien moi truong (copy thanh .env roi doi ten) ====
# Bat buoc: JWT_SECRET >= 32 ky tu (dung de ky token dang nhap).
# KHONG du dung secret mac dinh khi chay production.
JWT_SECRET=thay_bang_chuoi_ngau_nhien_dai_hoat_32_ky_tu_tren

# ==== CSDL MySQL ====
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/soccerhub_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=1234

# ==== SMTP (gui email xac nhan dat san / theo doi giai) — bo trong neu khong gui mail ====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=turfzone.dn@gmail.com

# ==== Port ====
SERVER_PORT=8080
