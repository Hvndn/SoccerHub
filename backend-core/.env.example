# ============================================================
# Turfzone Backend - biến môi trường
# Copy sang Railway / Render -> Variables (KHÔNG commit file .env thật)
# ============================================================

# --- Cách 1 (Khuyến nghị: Dùng Aiven MySQL Cloud - Không bao giờ mất dữ liệu) ---
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql-34457372-dienhovan2000-2d13.l.aivencloud.com:11149/defaultdb?sslMode=REQUIRED&serverTimezone=UTC&connectTimeout=15000&socketTimeout=60000
# SPRING_DATASOURCE_USERNAME=avnadmin
# SPRING_DATASOURCE_PASSWORD=<paste_password_here>

# --- Cách 2 (Dùng MySQL có sẵn ở nơi khác) ---
SPRING_DATASOURCE_URL=jdbc:mysql://HOST:3306/Turfzone_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&connectTimeout=15000&socketTimeout=60000
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# --- Cách 2 (khuyến nghị khi dùng MySQL plugin của Railway) ---
# Nếu đã add plugin MySQL trên Railway và "Connect"/"Reference Variables",
# Railway tự Inject các biến MYSQL* này - KHÔNG cần khai báo tay:
# MYSQLHOST=...
# MYSQLPORT=3306
# MYSQLDATABASE=Turfzone_db
# MYSQLUSER=root
# MYSQLPASSWORD=...

# --- CORS: các domain được phép gọi API ---
ALLOWED_ORIGINS=https://soccer-hub-wheat.vercel.app,http://localhost:3000

# --- AI service (FastAPI) ---
AI_SERVICE_URL=https://Turfzone-ai-service.onrender.com

# --- Debug (để false trên production) ---
JPA_SHOW_SQL=false

# --- Schema tự động ---
# Mặc định (không khai báo) = update: tự tạo/cập nhật bảng khi MySQL sẵn sàng.
# Đặt =none nếu muốn backend khởi động được ngay cả khi MySQL chưa kết nối
# (dùng để kiểm tra service có bind cổng OK không). Sau khi DB ổn, XOÁ biến này.
# DDL_AUTO=none
