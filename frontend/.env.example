# ==== SoccerHub — biến môi trường cho FRONTEND ====
# Copy file này thành `.env.local` khi chạy local.
# KHI DEPLOY LÊN VERCEL: dán 2 biến dưới vào Project Settings > Environment Variables
# (áp dụng cho cả Production, Preview và Development rồi redeploy).

# Backend Spring Boot — BẮT BUỘC khi deploy (không có thì trang gọi localhost và hỏng)
NEXT_PUBLIC_API_BASE_URL=https://soccerhub-backend-core-production.up.railway.app

# AI service FastAPI — tuỳ chọn, bỏ trống thì tính năng AI tự tắt (không làm hỏng trang)
NEXT_PUBLIC_AI_BASE_URL=

# ---- Local (để trỏ về máy mình khi code) ----
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# NEXT_PUBLIC_AI_BASE_URL=http://localhost:8000
